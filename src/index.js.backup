app.use(express.json());

// API ทักทายตามใบงาน
app.get('/hello', (req, res) => {
  res.json({
    message: 'Hello from Internship Log API'
  });
});

// ข้อมูลฝึกงานตัวอย่าง เก็บในหน่วยความจำ
let internships = [];
let nextId = 1;
const express = require('express');

const express = require('express');

const app = express();
const PORT = 3000;

app.use(express.json());

// API ทักทายตามใบงาน
app.get('/hello', (req, res) => {
  res.json({
    message: 'Hello from Internship Log API'
  });
});

// ข้อมูลฝึกงานตัวอย่าง เก็บในหน่วยความจำ
let internships = [];
let nextId = 1;

// ตรวจสอบว่า API ทำงานหรือไม่
app.get('/api', (req, res) => {
  res.json({
    message: 'Internship Log API is running',
    project: 'ระบบบันทึกการฝึกงาน'
  });
});

// ดูรายการบันทึกการฝึกงานทั้งหมด
app.get('/api/internships', (req, res) => {
  res.json({
    message: 'รายการบันทึกการฝึกงาน',
    total: internships.length,
    data: internships
  });
});

// เพิ่มบันทึกการฝึกงาน
app.post('/api/internships', (req, res) => {
  const { studentName, company, workDate, details } = req.body;

  if (!studentName || !company || !workDate || !details) {
    return res.status(400).json({
      message: 'กรุณากรอก studentName, company, workDate และ details ให้ครบ'
    });
  }

  const internship = {
    id: nextId++,
    studentName,
    company,
    workDate,
    details,
    createdAt: new Date().toISOString()
  };

  internships.push(internship);

  res.status(201).json({
    message: 'บันทึกข้อมูลฝึกงานสำเร็จ',
    data: internship
  });
});

// เปิดเซิร์ฟเวอร์
app.listen(PORT, () => {
  console.log(`Server running at http://localhost:${PORT}`);
